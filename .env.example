# Required only for analysis. App starts and serves pages without it.
GEMINI_API_KEY=

# Configurable Gemini models
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Local development (docker-compose maps 5433:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/resumematch

# Limits
MAX_UPLOAD_SIZE_MB=5
MAX_RESUME_TEXT_LENGTH=15000
MAX_JD_LENGTH=10000
MAX_JOB_TITLE_LENGTH=200

# Authentication
JWT_SECRET_KEY=change-this-secret-key-in-production-resume-matcher-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
